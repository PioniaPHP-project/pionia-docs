#!/usr/bin/env python3
"""Check root-relative links in a built Hugo site (no network required)."""
import sys
from html.parser import HTMLParser
from pathlib import Path
from urllib.parse import unquote, urlsplit

class PageLinks(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = set()

    def handle_starttag(self, tag, attrs):
        if tag == "a":
            self.links.update(value for key, value in attrs
                              if key == "href" and value and value.startswith("/")
                              and not value.startswith("//"))

root = Path(sys.argv[1] if len(sys.argv) > 1 else "public")
pages = list(root.rglob("*.html"))
if not pages:
    sys.exit(f"No HTML pages found in {root}; build the site first.")
missing = {}
for page in pages:
    parser = PageLinks()
    parser.feed(page.read_text())
    for href in parser.links:
        target = root / unquote(urlsplit(href).path).lstrip("/")
        if not target.is_file() and not (target / "index.html").is_file():
            missing.setdefault(href, []).append(str(page.relative_to(root)))
for href, sources in sorted(missing.items()):
    print(f"Missing {href}: {', '.join(sources[:3])}")
if missing:
    sys.exit(1)
print(f"docs-links: passed ({len(pages)} pages)")
